{
  "version": 2,
  "name": "stacked-burger-bar",
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*\\.(?:txt|html|css|js|png|jpg|jpeg|svg|gif|webp|ico))", "dest": "/$1" },
    { "src": "/templates/(.*)", "dest": "/templates/$1" },
    { "src": "/styles/(.*)", "dest": "/styles/$1" },
    { "src": "/public/(.*)", "dest": "/public/$1" }
  ]
}
